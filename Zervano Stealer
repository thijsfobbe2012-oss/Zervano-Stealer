-- Overlay control helpers
local function fadeOverlay(visible, duration)
    duration = duration or 0.35
    if visible then
        Overlay.Visible = true
        Overlay.BackgroundTransparency = 1
        StealText.TextTransparency = 1
        OverlaySub.TextTransparency = 1
        OverlayLogo.BackgroundTransparency = 1
        OverlayLogoInner.BackgroundTransparency = 1
        ringOuterStroke.Transparency = 1
        BarBg.BackgroundTransparency = 1
        BarFill.BackgroundTransparency = 1
        PercentText.TextTransparency = 1
        TweenService:Create(Overlay, TweenInfo.new(duration), {BackgroundTransparency = 0}):Play()
        TweenService:Create(StealText, TweenInfo.new(duration + 0.1), {TextTransparency = 0}):Play()
        TweenService:Create(OverlaySub, TweenInfo.new(duration + 0.15), {TextTransparency = 0}):Play()
        TweenService:Create(OverlayLogo, TweenInfo.new(duration + 0.1), {BackgroundTransparency = 0}):Play()
        TweenService:Create(OverlayLogoInner, TweenInfo.new(duration + 0.15), {BackgroundTransparency = 0}):Play()
        TweenService:Create(ringOuterStroke, TweenInfo.new(duration + 0.15), {Transparency = 0.6}):Play()
        TweenService:Create(BarBg, TweenInfo.new(duration + 0.15), {BackgroundTransparency = 0}):Play()
        TweenService:Create(BarFill, TweenInfo.new(duration + 0.15), {BackgroundTransparency = 0}):Play()
        TweenService:Create(PercentText, TweenInfo.new(duration + 0.15), {TextTransparency = 0}):Play()
    else
        local tweens = {
            TweenService:Create(Overlay, TweenInfo.new(duration), {BackgroundTransparency = 1}),
            TweenService:Create(StealText, TweenInfo.new(duration), {TextTransparency = 1}),
            TweenService:Create(OverlaySub, TweenInfo.new(duration), {TextTransparency = 1}),
            TweenService:Create(OverlayLogo, TweenInfo.new(duration), {BackgroundTransparency = 1}),
            TweenService:Create(OverlayLogoInner, TweenInfo.new(duration), {BackgroundTransparency = 1}),
            TweenService:Create(ringOuterStroke, TweenInfo.new(duration), {Transparency = 1}),
            TweenService:Create(BarBg, TweenInfo.new(duration), {BackgroundTransparency = 1}),
            TweenService:Create(BarFill, TweenInfo.new(duration), {BackgroundTransparency = 1}),
            TweenService:Create(PercentText, TweenInfo.new(duration), {TextTransparency = 1}),
        }
        for _, t in ipairs(tweens) do t:Play() end
        tweens[1].Completed:Connect(function()
            Overlay.Visible = false
        end)
    end
end

local function setProgress(p)
    p = math.clamp(p, 0, 1)
    TweenService:Create(BarFill, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.new(p, 0, 1, 0),
    }):Play()
    PercentText.Text = tostring(math.floor(p * 100)) .. "%"
end

