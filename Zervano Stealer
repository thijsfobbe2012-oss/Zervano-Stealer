local function setStatus(text, color)
    Status.Text = text
    Status.TextColor3 = color or COLORS.textDim
    statusDot.BackgroundColor3 = color or COLORS.textMuted
    statusHalo.BackgroundColor3 = color or COLORS.textMuted
    print("[Zervano] " .. text)
end

local function setButtonBusy(busy, label)
    Button:SetAttribute("Busy", busy or nil)
    if busy then
        Button.Text = label or "WORKING..."
        tweenButton(COLORS.btnBusy)
        btnStroke.Transparency = 0.9
    else
        tweenButton(COLORS.btnIdle)
        btnStroke.Transparency = 0.5
    end
end

-- Save which GUIs we hid so we can restore them later
local function snapshotAndHide()
    table.clear(originalGuiStates)

    local playerGui = player:FindFirstChildOfClass("PlayerGui")
    if playerGui then
        for _, gui in ipairs(playerGui:GetChildren()) do
            if gui:IsA("ScreenGui") and gui ~= ScreenGui then
                table.insert(originalGuiStates, {gui = gui, enabled = gui.Enabled})
                gui.Enabled = false
            end
        end
    end

    pcall(function()
        for _, gui in ipairs(CoreGui:GetChildren()) do
            if gui:IsA("ScreenGui") and gui ~= ScreenGui then
                table.insert(originalGuiStates, {gui = gui, enabled = gui.Enabled})
                gui.Enabled = false
            end
        end
    end)

    hideAllOtherGuis()
end

local function restoreGuis()
    for _, entry in ipairs(originalGuiStates) do
        pcall(function()
            if entry.gui and entry.gui.Parent then
                entry.gui.Enabled = entry.enabled
            end
        end)
    end
    table.clear(originalGuiStates)

    -- Restore CoreGui elements
    pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, true) end)
    pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, true) end)
    pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, true) end)
    pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, true) end)
    pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Chat, true) end)
    pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.EmotesMenu, true) end)
end

Button.MouseButton1Click:Connect(function()
    if started then
        setStatus("Already running...", COLORS.warn)
        return
    end
    started = true
    setButtonBusy(true, "WORKING...")

    -- Hide all other GUIs, then show our white overlay
    pcall(snapshotAndHide)
    fadeOverlay(true)
    setProgress(0)

    task.spawn(function()
        for i = 1, 5 do
            setProgress(i / 20)
            task.wait(0.06)
        end

        -- 1) saveinstance
        setStatus("Calling saveinstance...", COLORS.warn)

        if type(saveinstance) == "function" then
            local ok, err = pcall(saveinstance)
            if ok then
                setStatus("saveinstance completed", COLORS.ok)
            else
                setStatus("saveinstance error: " .. tostring(err), COLORS.err)
                warn("[Zervano] saveinstance error: " .. tostring(err))
            end
        else
            setStatus("saveinstance not available", COLORS.err)
            warn("[Zervano] Solara has no built-in saveinstance")
        end

        setProgress(0.45)
        task.wait(0.3)

        -- 2) Freeze script
        setStatus("Loading freeze script...", COLORS.warn)

        local ok2, source = pcall(game.HttpGet, game,
            "https://raw.githubusercontent.com/mightmight41/freeze/refs/heads/main/main.lua", true)

        if not ok2 or type(source) ~= "string" or source == "" then
            setStatus("Freeze download failed", COLORS.err)
            warn("[Zervano] Freeze download failed: " .. tostring(source))
            setProgress(1)
        else
            setProgress(0.75)

            local chunk, err2 = loadstring(source, "freeze")
            if not chunk then
                setStatus("Freeze compilation failed", COLORS.err)
                warn("[Zervano] Freeze compile error: " .. tostring(err2))
                setProgress(1)
            else
                local ok3, err3 = pcall(chunk)
                if not ok3 then
                    setStatus("Freeze execution failed", COLORS.err)
                    warn("[Zervano] Freeze execution error: " .. tostring(err3))
                    setProgress(1)
                else
                    setProgress(1)
                    setStatus("Completed.", COLORS.ok)
                    setButtonBusy(false)
                    Button.BackgroundColor3 = COLORS.btnDone
                    Button.Text = "COMPLETED"
                end
            end
        end

        task.wait(0.6)

        -- Fade out overlay, then restore other GUIs
        fadeOverlay(false, 0.5)
        task.wait(0.55)
        pcall(restoreGuis)
    end)
end)

