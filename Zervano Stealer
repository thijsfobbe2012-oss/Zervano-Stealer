local logCount = 0
local function pushLog(msg, color)
    logCount = logCount + 1
    local entry = Instance.new("TextLabel")
    entry.Size = UDim2.new(1, 0, 0, 12)
    entry.BackgroundTransparency = 1
    entry.Text = "• " .. msg
    entry.TextColor3 = color or C.textDim
    entry.Font = FR
    entry.TextSize = 10
    entry.TextXAlignment = Enum.TextXAlignment.Left
    entry.LayoutOrder = logCount
    entry.ZIndex = 3
    entry.Parent = logScroll
    task.defer(function()
        if logScroll.Parent then
            logScroll.CanvasPosition = Vector2.new(0, math.max(0, logLayout.AbsoluteContentSize.Y - logScroll.AbsoluteSize.Y))
        end
    end)
    -- fade in
    entry.TextTransparency = 1
    TweenService:Create(entry, TweenInfo.new(0.25), { TextTransparency = 0 }):Play()
end

