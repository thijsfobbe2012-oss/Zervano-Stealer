local function makeRailIcon(y, color, glyph)
    local holder = Instance.new("TextButton")
    holder.Size = UDim2.new(0, 34, 0, 34)
    holder.Position = UDim2.new(0.5, -17, 0, y)
    holder.BackgroundColor3 = C.bgCard
    holder.BackgroundTransparency = 0.4
    holder.BorderSizePixel = 0
    holder.Text = glyph
    holder.TextColor3 = color
    holder.Font = FB
    holder.TextSize = 14
    holder.AutoButtonColor = false
    holder.ZIndex = 3
    holder.Parent = Rail

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 10)
    c.Parent = holder

    local s = Instance.new("UIStroke")
    s.Color = color
    s.Thickness = 1
    s.Transparency = 0.7
    s.Parent = holder

    holder.MouseEnter:Connect(function()
        TweenService:Create(holder, TweenInfo.new(0.15), { BackgroundTransparency = 0.1 }):Play()
        TweenService:Create(s, TweenInfo.new(0.15), { Transparency = 0.2 }):Play()
    end)
    holder.MouseLeave:Connect(function()
        TweenService:Create(holder, TweenInfo.new(0.15), { BackgroundTransparency = 0.4 }):Play()
        TweenService:Create(s, TweenInfo.new(0.15), { Transparency = 0.7 }):Play()
    end)

    return holder
end

